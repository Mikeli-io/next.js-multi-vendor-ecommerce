// Covet — Phase 1 schema: authentication & authorization only.
// Marketplace models (products, orders, cart, ...) are intentionally absent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A user has exactly one role. Guests are unauthenticated and are not a role.
enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

/// Approval state of a *store*, kept separate from the user's account identity.
enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// The single identity/authentication record for every role.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Present only when `role` is VENDOR.
  vendor Vendor?

  @@map("users")
}

/// The store behind a `role = VENDOR` user. Holds store identity and approval
/// state only — earnings, catalog and payouts belong to later phases.
model Vendor {
  id        String       @id @default(cuid())
  userId    String       @unique
  storeName String
  slug      String       @unique
  status    VendorStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vendors")
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

/// A product brand, managed by admins.
///
/// There is no Product model yet, so there is no Product → Brand relation and
/// deliberately no stored product count: when Product is added, give it a
/// `brandId` (onDelete: Restrict, so deleting a used brand fails loudly) and
/// derive counts from that relation.
model Brand {
  id        String      @id @default(cuid())
  name      String      @unique
  /// Derived from `name` on the server; never user input.
  slug      String      @unique
  /// Public URL path of the uploaded logo, e.g. /uploads/brands/<uuid>.png
  image     String?
  status    BrandStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@map("brands")
}

/// Top level of the catalog taxonomy: Category → SubCategory → SubSubCategory.
///
/// No Product model exists yet, so there are no product relations or stored
/// product counts; when Product is added, relate it to the deepest level it
/// is classified under and derive counts from that relation.
model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  /// Derived from `name` on the server; never user input.
  slug          String        @unique
  /// Public URL path of the uploaded image, e.g. /uploads/categories/<uuid>.png
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id               String           @id @default(cuid())
  name             String
  categoryId       String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  /// Restrict: a category with sub categories cannot be deleted.
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subSubCategories SubSubCategory[]

  /// Names are unique within a category ("Accessories" may exist under several).
  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("sub_categories")
}

/// Its category is derived through `subCategory` — deliberately no categoryId
/// here, so the two can never disagree.
model SubSubCategory {
  id            String      @id @default(cuid())
  name          String
  subCategoryId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  /// Restrict: a sub category with sub sub categories cannot be deleted.
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)

  @@unique([subCategoryId, name])
  @@index([subCategoryId])
  @@map("sub_sub_categories")
}
