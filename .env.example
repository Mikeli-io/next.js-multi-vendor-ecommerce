# ---------------------------------------------------------------------------
# Covet — environment variables
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# MySQL/MariaDB connection string used by Prisma.
DATABASE_URL="mysql://user:password@localhost:3306/Covet"

# Authentication ------------------------------------------------------------
# Signing key for the JWT session cookie. Generate with: openssl rand -base64 32
# Auth.js v5 reads AUTH_SECRET and accepts NEXTAUTH_SECRET as an alias.
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"

# The canonical origin of the app. Required in production.
NEXTAUTH_URL="http://localhost:3000"

# Admin seed ----------------------------------------------------------------
# Consumed only by `npm run db:seed`. Admins cannot self-register; this is the
# only path that creates an ADMIN account. Re-running the seed is a no-op.
ADMIN_EMAIL="admin@covet.test"
ADMIN_PASSWORD="replace-me-min-12-chars"
ADMIN_NAME="Covet Admin"

# Application ---------------------------------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser. Never put a secret here.
NEXT_PUBLIC_APP_NAME="Covet"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
